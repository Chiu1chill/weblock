{
  "manifest_version": 3,
  "name": "Weblock",
  "version": "1.0.0",
  "description": "Protect selected websites with a password for 12 hours.",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Weblock",
    "default_popup": "popup.html"
  }
}